<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- A reply keeps generating after Butler is left, and says when it lands. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Held only while a reply generates: some phones (Transsion's "Hiber") freeze an app
         with a foreground service anyway and cut its connection mid-stream. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Asks, once and only from Settings or a cut-off reply, to be left running. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".ButlerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Butler.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Butler.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth redirect. Reuses the scheme Janitor's Supabase project already
                 allow-lists (janitor://…), so the Google/Discord/Apple redirect lands
                 back in Butler. Any janitor:// path matches. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="janitor" android:host="auth" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".core.background.ButlerWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/butler_widget_info" />
        </receiver>

        <service
            android:name=".core.background.ReplyService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
